# Skopiuj do .env.local (lokalnie) oraz ustaw w Vercel -> Settings -> Environment Variables.

# Baza Neon — pojawi sie automatycznie po dodaniu integracji Neon w Vercelu.
DATABASE_URL="postgres://uzytkownik:haslo@host.neon.tech/dbname?sslmode=require"

# NextAuth. SECRET wygeneruj: openssl rand -base64 32
NEXTAUTH_SECRET="wklej-tu-losowy-sekret"
# Fallback URL (uzywany, gdy zadanie nie pasuje do listy ponizej). Lokalnie: http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"
# Lista dozwolonych adresow (local/test/prod) po przecinku. Endpoint auth sam wybiera
# adres zgodny z biezacym zadaniem — dzieki temu TEN SAM plik dziala w kazdym srodowisku.
NEXTAUTH_ALLOWED_ORIGINS="http://localhost:3000,https://test.twoja-domena.pl,https://tcmkongreskrakow.pl"

# Konta panelu. Wartosc HASH to hash bcrypt zakodowany w base64
# (wygeneruj: node scripts/change-password.js admin).
# Base64 nie ma znaku $, wiec TA SAMA wartosc dziala lokalnie i na Vercel — bez escapowania.
ADMIN_USER="admin"
ADMIN_PASSWORD_HASH="<base64>"

# Konto podgladu (widzi tylko zagregowane liczby).
VIEWER_USER="podglad"
VIEWER_PASSWORD_HASH="<base64>"
